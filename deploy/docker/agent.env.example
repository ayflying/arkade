# 复制为此目录的 .env；真实值不要提交、发送或写进日志。
# 独立Agent部署，请勿复用同目录Hub演示环境的.env覆盖现有服务。
# 网页『添加服务器』或『重置密钥』生成的专属接入密钥（只展示一次）
ARKADE_AGENT_TOKEN=
# 跨机器时必须填可达的Hub地址；不要写容器服务名hub或Agent自己的127.0.0.1。
# 生产建议wss://你的域名/agent/connect，内网测试可用ws://Hub地址:端口/agent/connect。
ARKADE_AGENT_HUB_URL=
# 本地构建或你自己的可信仓库镜像，不预设有公开发布镜像
ARKADE_AGENT_IMAGE=arkade-agent:debug
ARKADE_AGENT_NAME=arkade-node
ARKADE_RESTART_POLICY=unless-stopped
ARKADE_AGENT_DATA_DIR=/opt/arkade/agent
ARKADE_AGENT_SOCKET=
ARKADE_AGENT_RUNTIME_KIND=auto
ARKADE_AGENT_HEARTBEAT_SEC=15
ARKADE_LOG_LEVEL=info
ARKADE_LOG_FORMAT=text
ARKADE_DOCKER_SOCKET=/var/run/docker.sock
