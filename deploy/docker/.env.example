# Arkade 调试环境变量（复制为 .env 后修改，勿提交）
#
#   cp deploy/docker/.env.example deploy/docker/.env
#
# .env 已在 .gitignore 中排除，不会被提交。

# Hub 对外端口
ARKADE_HUB_PORT=8080

# 初始管理员密码（至少 8 位）。首次启动时用于创建 admin 账号。
# 【必须自己填】不要留空，也不要使用示例值——本文件会被提交到仓库，
# 任何写在这里的值都等同于公开的密码。
ARKADE_INITIAL_PASS=

# Agent 接入令牌（至少 16 位）。Hub 与 Agent 必须一致。
# 【必须自己填】生成方式示例：openssl rand -hex 24
ARKADE_AGENT_TOKEN=

# 镜像版本标签，仅用于记录与排查
ARKADE_VERSION=0.1.0
