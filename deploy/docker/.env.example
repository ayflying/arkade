# Arkade 容器编排的环境变量（唯一填写凭据的地方）
#
# 用法：
#   cp deploy/docker/.env.example deploy/docker/.env
#   # 编辑 .env，填好下面两个凭据
#   docker compose -f deploy/docker/docker-compose.yml up -d --build
#
# 说明：
#   - compose 会自动读取与本文件同目录的 .env，启动时无需 --env-file；
#   - .env 已被 .gitignore 排除，不会提交；本文件（.env.example）会被提交，
#     所以里面绝不能放可用的密码或令牌；
#   - 程序配置文件里的凭据字段都留空，实际值统一由这里注入。

# Hub 对外端口
ARKADE_HUB_PORT=8080

# 初始管理员密码（至少 8 位）。首次启动时用于创建 admin 账号。
# 【必须填写】留空会导致 compose 校验失败并不启动。
ARKADE_INITIAL_PASS=

# Agent 接入令牌（至少 16 位）。Hub 与 Agent 必须完全一致。
# 【必须填写】生成方式：openssl rand -hex 24
ARKADE_AGENT_TOKEN=

# 镜像版本标签，仅用于记录与排查
ARKADE_VERSION=0.1.0
