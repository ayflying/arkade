# Hub 独立部署 / Hub+Agent 合并部署的配置样例。
# 在仓库根目录复制为 .env，命令显式加 --env-file .env。
# 真实配置不要提交；不要公开 docker compose config 展开的密钥。

# 必填：首次创建管理员用，已有账号不会被此值重置。
ARKADE_INITIAL_USER=admin
ARKADE_INITIAL_PASS=
# Hub 准入令牌（至少 16 位），不是网页生成的 Agent 专属密钥。
ARKADE_AGENT_TOKEN=

# 镜像请固定为同次构建的 sha-标签或摘要；此版本必须支持无 TOML 启动。
ARKADE_HUB_IMAGE=ghcr.io/ayflying/arkade-hub:latest
ARKADE_AGENT_IMAGE=ghcr.io/ayflying/arkade-agent:latest
ARKADE_VERSION=0.1.0
ARKADE_HUB_BIND_IP=0.0.0.0
ARKADE_HUB_PORT=8080
# 对外浏览器访问地址；使用 OIDC 时应为稳定的 HTTPS 地址。
ARKADE_BASE_URL=http://127.0.0.1:8080
ARKADE_HUB_LOG_LEVEL=info
# 网页会话策略保存在数据库，本项不能覆盖系统设置的 TTL。
ARKADE_SESSION_TTL=24h

# 升级必须保留原卷名；自定义配置的数据库路径须先单独核对。
ARKADE_HUB_VOLUME=arkade-hub-data
ARKADE_HUB_NETWORK=arkade-hub-net

# 仅合并部署需要：先仅启动 hub，在网页添加本机服务器，再填专属密钥启动 agent。
# 与上方 Hub 准入令牌分离，不能互相替代。
ARKADE_LOCAL_AGENT_TOKEN=
ARKADE_AGENT_NAME=arkade-node
ARKADE_AGENT_VOLUME=arkade-agent-data
ARKADE_DOCKER_SOCKET=/var/run/docker.sock
ARKADE_RUNTIME_KIND=auto
ARKADE_HEARTBEAT_SEC=15
ARKADE_AGENT_LOG_LEVEL=info
ARKADE_AGENT_LOG_FORMAT=text
