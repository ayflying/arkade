# Arkade 主节点凭据文件（只放密码和令牌，其余配置写在 hub-compose.yml 里）
#
# 用法（在仓库根目录）：
#   cp deploy/docker/.env.example .env    # compose 默认读项目目录即仓库根目录的 .env
#   # 编辑 .env，填好下面两个必填凭据
#   docker compose -f deploy/docker/hub-compose.yml up -d --build
#
# 说明：
#   - .env 在仓库根目录，已被 .gitignore 排除，不会提交；
#   - 本文件会被提交，所以这里绝不能出现可用的密码或令牌；
#   - 端口、容器名、日志级别等普通参数不在本文件，直接在 hub-compose.yml 里改。

# ============================================================
# 必填凭据
# ============================================================

# 初始管理员密码（至少 8 位）。首次启动时用于创建 admin 账号。
# 留空会导致 compose 校验失败并拒绝启动。
ARKADE_INITIAL_PASS=

# Agent 准入令牌（至少 16 位）。Hub 侧保存这一份；
# 每台被管服务器的 Agent 用它自己的专属令牌连接（网页「添加服务器」生成）。
# 生成方式：openssl rand -hex 24
ARKADE_AGENT_TOKEN=
