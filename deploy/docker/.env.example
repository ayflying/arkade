# Arkade 容器编排环境变量（唯一填写实际值的地方）
#
# 用法：
#   cp deploy/docker/.env.example deploy/docker/.env
#   # 编辑 .env，至少填好两个必填凭据
#   docker compose -f deploy/docker/docker-compose.yml up -d --build
#
# 说明：
#   - 所有可配置项都在 docker-compose.yml 里用 ${VAR} 形式读取本文件；
#   - compose 会自动读取同目录的 .env，启动时无需 --env-file；
#   - .env 已被 .gitignore 排除，不会提交；本文件会被提交，
#     所以这里绝不能出现可用的密码或令牌。
#
# 取值写法：VAR=              → 留空（部分变量表示"使用默认行为"）
#           VAR=value         → 指定值
# 不写某个变量时，使用 compose 里 ${VAR:-默认值} 给出的默认值。

# ============================================================
# 必填凭据
# ============================================================

# 初始管理员密码（至少 8 位）。首次启动时用于创建 admin 账号。
# 留空会导致 compose 校验失败并拒绝启动。
ARKADE_INITIAL_PASS=

# Agent 接入令牌（至少 16 位）。Hub 与 Agent 必须完全一致。
# 生成方式：openssl rand -hex 24
ARKADE_AGENT_TOKEN=

# ============================================================
# 端口与命名
# ============================================================

# Hub 对外端口
ARKADE_HUB_PORT=8080

# compose 项目名（影响容器/网络分组，一般不用改）
ARKADE_PROJECT_NAME=arkade-debug

# 容器名、镜像名、卷名、网络名：改成别的值可以让多套环境并存
ARKADE_HUB_CONTAINER=arkade-hub-debug
ARKADE_AGENT_CONTAINER=arkade-agent-debug
ARKADE_HUB_IMAGE=arkade-hub:debug
ARKADE_AGENT_IMAGE=arkade-agent:debug
ARKADE_HUB_VOLUME=arkade-debug-hub-data
ARKADE_AGENT_VOLUME=arkade-debug-agent-data
ARKADE_NETWORK=arkade-debug-net

# 重启策略：no / always / unless-stopped / on-failure
ARKADE_RESTART_POLICY=unless-stopped

# 镜像版本标签，仅用于记录与排查
ARKADE_VERSION=0.1.0

# ============================================================
# Hub
# ============================================================

# 容器内监听地址。容器里必须监听 0.0.0.0，否则端口映射进不来。
ARKADE_HUB_LISTEN=0.0.0.0:8080

# 对外访问地址（用于前端展示与回调，按实际域名/IP 填）
# ARKADE_BASE_URL=

# 登录会话有效期，支持 30m / 24h / 72h 这类写法
ARKADE_SESSION_TTL=72h

# 首次启动创建的管理员用户名
ARKADE_INITIAL_USER=admin

# 数据库文件路径（容器内路径，默认在 /data 卷上）
ARKADE_DB_PATH=/data/hub.db

# 前端产物目录（镜像内已放好，一般不用改）
ARKADE_WEB_DIST=/app/web/dist

# ============================================================
# Agent
# ============================================================

# 服务器显示名。容器 hostname 就是容器 ID，不显式指定的话每次重建名字都会漂移。
ARKADE_AGENT_NAME=arkade-debug-node

# Hub 地址。容器内必须用服务名 hub，写 127.0.0.1 会指向 Agent 自己的容器。
ARKADE_AGENT_HUB_URL=ws://hub:8080/agent/connect

# 数据目录（挂卷持久化，重启后复用同一个 agent_id）
ARKADE_AGENT_DATA_DIR=/opt/arkade/agent

# 运行时套接字。留空 = 自动发现（$DOCKER_HOST → docker.sock → podman.sock）
ARKADE_AGENT_SOCKET=

# 运行时类型偏好：auto / docker / podman（只影响探测顺序）
ARKADE_AGENT_RUNTIME_KIND=auto

# 兜底心跳间隔（秒）。Hub 在握手应答里给出值后以其为准。
ARKADE_AGENT_HEARTBEAT_SEC=15

# 宿主机 Docker 套接字路径。非常规安装位置时改这里。
ARKADE_DOCKER_SOCKET=/var/run/docker.sock

# ============================================================
# 日志与健康检查（Hub 与 Agent 共用）
# ============================================================

# 日志级别：debug / info / warn / error
ARKADE_LOG_LEVEL=info
# 日志格式：text / json
ARKADE_LOG_FORMAT=text

# Hub 健康检查参数（容器编排里用来判断"真的起来了没有"）
ARKADE_HEALTH_INTERVAL=10s
ARKADE_HEALTH_TIMEOUT=3s
ARKADE_HEALTH_START_PERIOD=10s
ARKADE_HEALTH_RETRIES=5
