# Arkade 凭据文件（只放密码和令牌，其余配置写在 docker-compose.yml 里）
#
# 用法：
#   cp deploy/docker/.env.example .env    # 复制到仓库根目录（compose 默认读这里）
#   # 编辑 .env，填好下面两个必填凭据
#   docker compose -f deploy/docker/docker-compose.yml up -d --build
#
# 说明：
#   - .env 在仓库根目录，已被 .gitignore 排除，不会提交；
#   - 本文件会被提交，所以这里绝不能出现可用的密码或令牌；
#   - 端口、容器名、日志级别等普通参数不在本文件，直接在编排文件里改。

# ============================================================
# 必填凭据
# ============================================================

# 初始管理员密码（至少 8 位）。首次启动时用于创建 admin 账号。
# 留空会导致 compose 校验失败并拒绝启动。
ARKADE_INITIAL_PASS=

# Agent 接入令牌（至少 16 位）。Hub 与 Agent 必须完全一致。
# 生成方式：openssl rand -hex 24
ARKADE_AGENT_TOKEN=

# ============================================================
# 可选：外部编排根目录（Agent 只读挂载）
# ============================================================

# 只读挂给 Agent，用于读取**已有项目**的原始编排文件。
#
# 典型场景：宝塔面板创建的编排，配置在 /www/server/panel/data/compose/<项目>/，
# 容器标签里的 config_files 就是这条路径。不挂的话 Arkade 能看到容器，
# 但读不到原始 compose 文件（日志里是"读取编排配置失败"）。
#
# 填写规则：
#   - 只填一个目录，不要填 /（整台宿主机文件系统会进容器）；
#   - 挂载始终只读，Arkade 不会改这里的内容；
#   - 留空 = 不挂载。
#
# 例：ARKADE_COMPOSE_SOURCE_ROOT=/www/server/panel/data/compose
ARKADE_COMPOSE_SOURCE_ROOT=
