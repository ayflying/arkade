# 对应 combined-compose.yml，仅放 Hub + Agent 合并部署需要的凭据。
# 复制为部署目录的 .env；普通参数直接修改编排，真实凭据不要提交。
# PostgreSQL 新数据库密码。
ARKADE_DB_PASSWORD=
ARKADE_INITIAL_PASS=
# Hub 准入令牌（至少 16 位）。
ARKADE_AGENT_TOKEN=
# 本机 Agent 专属密钥：先启动 hub，在网页添加本机服务器，再填入并启动 agent。
# 与 Hub 准入令牌不同，不能互相替代；首次只起 hub 时可暂留空。
ARKADE_LOCAL_AGENT_TOKEN=
