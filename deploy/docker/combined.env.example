# 对应 combined-compose.yml，仅放 Hub + Agent 合并部署需要的凭据。
# 复制为部署目录的 .env；普通参数直接修改编排，真实凭据不要提交。
# PostgreSQL 新数据库密码。
ARKADE_DB_PASSWORD=
ARKADE_INITIAL_PASS=
# 合并部署只需下面这一把本机专属密钥，不需要 ARKADE_AGENT_TOKEN。
# 本机 Agent 专属随机密钥（至少16位，如 openssl rand -hex 24）。
# Hub 自动创建“本机”并绑定此密钥，Agent 自动连接，无需网页创建或复制密钥。
# 持久保存，重启保持不变；已有网页预建记录/密钥重置不会被自动覆盖。
ARKADE_LOCAL_AGENT_TOKEN=
